# Release builds (`pnpm build:ext`). Leave these empty until there's a production deployment
# (`npx convex deploy` in packages/backend); without them saved words stay in the browser.
PLASMO_PUBLIC_CONVEX_URL=
PLASMO_PUBLIC_CONVEX_SITE_URL=

# Release builds don't use the local helper: YouTube's captions only (lib/features.ts).
PLASMO_PUBLIC_LOCAL_HELPER=
