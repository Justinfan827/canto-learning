# Dev builds (`pnpm dev:ext`, `pnpm build:ext:dev`) sync with the dev Convex deployment.
# These are public: anything in a PLASMO_PUBLIC_ variable ships inside the extension.
PLASMO_PUBLIC_CONVEX_URL=https://rapid-labrador-930.convex.cloud
PLASMO_PUBLIC_CONVEX_SITE_URL=https://rapid-labrador-930.convex.site

# The local helper: transcription, disk backups, phone relay (lib/features.ts).
PLASMO_PUBLIC_LOCAL_HELPER=1
