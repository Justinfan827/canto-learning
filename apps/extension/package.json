{
  "name": "extension",
  "displayName": "Pause & Ask",
  "version": "0.1.0",
  "description": "Pause a Cantonese YouTube video and ask a tutor about what was just said.",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-dict.mjs --if-missing && plasmo dev",
    "build": "node scripts/build-dict.mjs --if-missing && plasmo build && node scripts/wrap-main-world.mjs",
    "package": "pnpm build && plasmo package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run lib",
    "smoke": "node e2e/smoke.mjs",
    "dict": "node scripts/build-dict.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@pna/backend": "workspace:^",
    "@pna/shared": "workspace:*",
    "convex": "^1.46.0",
    "idb": "^8.0.0",
    "plasmo": "0.90.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "fake-indexeddb": "^6.0.0",
    "playwright-core": "1.56.1",
    "typescript": "5.6.3",
    "vitest": "^2.1.0"
  },
  "manifest": {
    "permissions": [
      "sidePanel",
      "storage",
      "tabs"
    ],
    "host_permissions": [
      "https://www.youtube.com/*",
      "https://api.anthropic.com/*",
      "https://openrouter.ai/*",
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://*.convex.cloud/*"
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "action": {
      "default_title": "Open Pause & Ask"
    }
  }
}
